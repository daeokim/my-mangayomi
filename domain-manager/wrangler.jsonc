{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daeo-domain-manager",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-09",
  "workers_dev": true,
  "triggers": { "crons": ["7,17,27,37,47 * * * *"] },
  "vars": { "GITHUB_REPOSITORY": "daeokim/my-mangayomi", "GITHUB_BRANCH": "main" },
  "observability": { "enabled": true }
}
